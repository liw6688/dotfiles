[alias]
  co = checkout
  ci = commit
  br = branch
  st = status
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[user]
	name = LI Wei
{{- if hasKey . "email" }}
	email = {{ .email }}
{{- else }}
	# Email 不入公开仓库：在 ~/.config/chezmoi/chezmoi.toml 的 [data] 里设 email，
	# 或直接 `git config --global user.email`。
{{- end }}
{{- if hasKey . "gitIncludes" }}
{{- range .gitIncludes }}
[includeIf "gitdir:{{ .gitdir }}"]
    path = {{ .path }}
{{- end }}
{{- end }}
[init]
  defaultBranch = main
[core]
	editor = vim
	pager = less -x1,5
	autocrlf = input
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = true
[push]
	default = simple
[pull]
	ff = only
[merge]
	ff = only
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# 多账号：按 remote 地址切换身份。真实账号和邮箱在 ~/.config/chezmoi/chezmoi.toml
# 的 gitUrlIncludes / gitUrlRewrites 里（带说明），不进这个公开仓库。
# - includeIf：remote 地址匹配时额外加载一个文件，通常用来覆盖 user.email
# - url.insteadOf：把某个账号的仓库地址改写成 ~/.ssh/config 里的 Host 别名，
#   让 ssh 用对应账号的 key，clone 时直接复制网页地址即可
{{- if hasKey . "gitUrlIncludes" }}
{{- range .gitUrlIncludes }}
[includeIf "hasconfig:remote.*.url:{{ .pattern }}"]
	path = {{ .path }}
{{- end }}
{{- end }}
{{- if hasKey . "gitUrlRewrites" }}
{{- range .gitUrlRewrites }}
[url "{{ .base }}"]
{{- range .insteadOf }}
	insteadOf = {{ . }}
{{- end }}
{{- end }}
{{- end }}
